//@version=5
indicator("fBO Setup PRO - Failed Breakout Helper", overlay=true, max_labels_count=500)

// 1. Inputs
emaLen = input.int(20, "EMA period")
atrLen = input.int(14, "ATR period")
rangeLen = input.int(20, "Trading range lookback")
breakoutAtr = input.float(0.10, "Breakout beyond range ATR", step=0.05)
minRangeAtr = input.float(1.20, "Min range height ATR", step=0.10)
maxRangeAtr = input.float(4.00, "Max range height ATR", step=0.10)
failureBars = input.int(3, "Bars allowed for breakout failure")

minBodyPct = input.float(0.30, "Min signal body %", step=0.05)
maxSignalAtr = input.float(2.00, "Max signal bar size ATR", step=0.10)
secondAttemptLookback = input.int(12, "Second attempt lookback")

showBarCount = input.bool(true, "Show session bar count")
barCountSession = input.session("0000-2359", "Bar count session")
barCountEvery = input.int(5, "Show every Nth bar number", minval=1)
barCountShowFirst = input.bool(true, "Always show b1")
barCountMax = input.int(120, "Max bars to number per session", minval=1)
barCountOffsetAtr = input.float(0.25, "Bar count label offset ATR", step=0.05)

// 2. Base series
ema20 = ta.ema(close, emaLen)
atr = ta.atr(atrLen)
plot(ema20, color=color.blue, linewidth=2, title="20 EMA")

// Session bar count. Use this to replace a separate bar-count indicator on TradingView free plans.
inBarCountSession = not na(time(timeframe.period, barCountSession))
newBarCountSession = inBarCountSession and (na(inBarCountSession[1]) or not inBarCountSession[1])
var int sessionBarCount = 0

if newBarCountSession
    sessionBarCount := 1
else if inBarCountSession
    sessionBarCount += 1
else
    sessionBarCount := 0

showThisBarNumber = showBarCount and inBarCountSession and sessionBarCount <= barCountMax and ((barCountShowFirst and sessionBarCount == 1) or sessionBarCount % barCountEvery == 0)

if showThisBarNumber
    label.new(bar_index, high + atr * barCountOffsetAtr, "b" + str.tostring(sessionBarCount), style=label.style_none, textcolor=color.new(color.gray, 20), size=size.tiny)

barRangeRaw = high - low
barRange = math.max(barRangeRaw, syminfo.mintick)
body = math.abs(close - open)

rangeHigh = ta.highest(high[1], rangeLen)
rangeLow = ta.lowest(low[1], rangeLen)
rangeHeight = rangeHigh - rangeLow
tradableRange = rangeHeight >= atr * minRangeAtr and rangeHeight <= atr * maxRangeAtr

strongBearSignal = close < open and body >= barRange * minBodyPct and barRangeRaw <= atr * maxSignalAtr
strongBullSignal = close > open and body >= barRange * minBodyPct and barRangeRaw <= atr * maxSignalAtr

// 3. Breakout and failure tracking
var bool watchingBullBreakoutFailure = false
var bool watchingBearBreakoutFailure = false
var float breakoutHigh = na
var float breakoutLow = na
var int breakoutBar = na
var int bullFailureAttemptCount = 0
var int bearFailureAttemptCount = 0

bullBreakout = tradableRange and high > rangeHigh + atr * breakoutAtr
bearBreakout = tradableRange and low < rangeLow - atr * breakoutAtr

if bullBreakout
    watchingBullBreakoutFailure := true
    watchingBearBreakoutFailure := false
    breakoutHigh := high
    breakoutBar := bar_index

if bearBreakout
    watchingBearBreakoutFailure := true
    watchingBullBreakoutFailure := false
    breakoutLow := low
    breakoutBar := bar_index

if watchingBullBreakoutFailure and bar_index - breakoutBar > failureBars
    watchingBullBreakoutFailure := false

if watchingBearBreakoutFailure and bar_index - breakoutBar > failureBars
    watchingBearBreakoutFailure := false

// Failed breakout: price breaks out, then rejects back into the prior range and triggers opposite direction.
shortFboSignal = watchingBullBreakoutFailure and close < rangeHigh and strongBearSignal
longFboSignal = watchingBearBreakoutFailure and close > rangeLow and strongBullSignal

if shortFboSignal
    bullFailureAttemptCount += 1
else if bar_index - nz(breakoutBar, bar_index) > secondAttemptLookback
    bullFailureAttemptCount := 0

if longFboSignal
    bearFailureAttemptCount += 1
else if bar_index - nz(breakoutBar, bar_index) > secondAttemptLookback
    bearFailureAttemptCount := 0

triggerShortFbo = shortFboSignal[1] and low < low[1]
triggerLongFbo = longFboSignal[1] and high > high[1]

secondShortAttempt = triggerShortFbo and bullFailureAttemptCount >= 2
secondLongAttempt = triggerLongFbo and bearFailureAttemptCount >= 2

if triggerShortFbo
    watchingBullBreakoutFailure := false

if triggerLongFbo
    watchingBearBreakoutFailure := false

plotshape(triggerShortFbo and not secondShortAttempt, title="fBO Short", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="fBO")
plotshape(secondShortAttempt, title="fBO Short 2nd", style=shape.triangledown, location=location.abovebar, color=color.maroon, size=size.small, text="fBO2")
plotshape(triggerLongFbo and not secondLongAttempt, title="fBO Long", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="fBO")
plotshape(secondLongAttempt, title="fBO Long 2nd", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="fBO2")

plot(rangeHigh, color=color.new(color.red, 80), title="Range high")
plot(rangeLow, color=color.new(color.green, 80), title="Range low")

alertcondition(triggerShortFbo, "fBO Short", "Failed breakout short candidate triggered")
alertcondition(triggerLongFbo, "fBO Long", "Failed breakout long candidate triggered")
