//@version=5
indicator("DP Setup PRO - Double Top/Bottom Pullback Helper", overlay=true, max_labels_count=500)

// 1. Inputs
emaLen = input.int(20, "EMA period")
atrLen = input.int(14, "ATR period")
pivotStrength = input.int(2, "Pivot strength")
matchAtr = input.float(0.25, "Double top/bottom tolerance ATR", step=0.05)
pullbackMinAtr = input.float(0.15, "Min pullback depth ATR", step=0.05)
pullbackMaxAtr = input.float(1.20, "Max pullback depth ATR", step=0.10)
maxBarsBetweenTops = input.int(50, "Max bars between double points")
maxBarsAfterDouble = input.int(20, "Max bars after double point")

minBodyPct = input.float(0.35, "Min signal body %", step=0.05)
maxEntryTailPct = input.float(0.35, "Max entry-side tail %", step=0.05)
maxSignalAtr = input.float(1.80, "Max signal bar size ATR", step=0.10)

showBarCount = input.bool(true, "Show session bar count")
barCountSession = input.session("0000-2359", "Bar count session")
barCountEvery = input.int(5, "Show every Nth bar number", minval=1)
barCountShowFirst = input.bool(true, "Always show b1")
barCountMax = input.int(120, "Max bars to number per session", minval=1)
barCountOffsetAtr = input.float(0.25, "Bar count label offset ATR", step=0.05)

// 2. Base series
ema20 = ta.ema(close, emaLen)
atr = ta.atr(atrLen)
plot(ema20, color=color.blue, linewidth=2, title="20 EMA")

// Session bar count. Use this to replace a separate bar-count indicator on TradingView free plans.
inBarCountSession = not na(time(timeframe.period, barCountSession))
newBarCountSession = inBarCountSession and (na(inBarCountSession[1]) or not inBarCountSession[1])
var int sessionBarCount = 0

if newBarCountSession
    sessionBarCount := 1
else if inBarCountSession
    sessionBarCount += 1
else
    sessionBarCount := 0

showThisBarNumber = showBarCount and inBarCountSession and sessionBarCount <= barCountMax and ((barCountShowFirst and sessionBarCount == 1) or sessionBarCount % barCountEvery == 0)

if showThisBarNumber
    label.new(bar_index, high + atr * barCountOffsetAtr, "b" + str.tostring(sessionBarCount), style=label.style_none, textcolor=color.new(color.gray, 20), size=size.tiny)

barRangeRaw = high - low
barRange = math.max(barRangeRaw, syminfo.mintick)
body = math.abs(close - open)
upperTail = high - math.max(open, close)
lowerTail = math.min(open, close) - low

strongBullSignal = close > open and body >= barRange * minBodyPct and upperTail <= barRange * maxEntryTailPct and barRangeRaw <= atr * maxSignalAtr
strongBearSignal = close < open and body >= barRange * minBodyPct and lowerTail <= barRange * maxEntryTailPct and barRangeRaw <= atr * maxSignalAtr

// 3. Double top / double bottom detection
ph = ta.pivothigh(high, pivotStrength, pivotStrength)
pl = ta.pivotlow(low, pivotStrength, pivotStrength)
phBar = bar_index - pivotStrength
plBar = bar_index - pivotStrength

var float prevPivotHigh = na
var int prevPivotHighBar = na
var float prevPivotLow = na
var int prevPivotLowBar = na

var bool doubleTopContext = false
var bool doubleBottomContext = false
var float doubleTopHigh = na
var float doubleBottomLow = na
var int doubleTopBar = na
var int doubleBottomBar = na
var int topPullbackState = 0
var int bottomPullbackState = 0
var float topPullbackLow = na
var float bottomPullbackHigh = na

if not na(ph)
    isDoubleTop = not na(prevPivotHigh) and phBar - prevPivotHighBar <= maxBarsBetweenTops and math.abs(ph - prevPivotHigh) <= atr * matchAtr
    if isDoubleTop
        doubleTopContext := true
        doubleBottomContext := false
        doubleTopHigh := math.max(ph, prevPivotHigh)
        doubleTopBar := phBar
        topPullbackState := 0
        topPullbackLow := na
    prevPivotHigh := ph
    prevPivotHighBar := phBar

if not na(pl)
    isDoubleBottom = not na(prevPivotLow) and plBar - prevPivotLowBar <= maxBarsBetweenTops and math.abs(pl - prevPivotLow) <= atr * matchAtr
    if isDoubleBottom
        doubleBottomContext := true
        doubleTopContext := false
        doubleBottomLow := math.min(pl, prevPivotLow)
        doubleBottomBar := plBar
        bottomPullbackState := 0
        bottomPullbackHigh := na
    prevPivotLow := pl
    prevPivotLowBar := plBar

// 4. Pullback after double point
if doubleTopContext
    if bar_index - doubleTopBar > maxBarsAfterDouble
        doubleTopContext := false
        topPullbackState := 0
    else if topPullbackState == 0 and low < low[1]
        topPullbackState := 1
        topPullbackLow := low
    else if topPullbackState == 1
        topPullbackLow := math.min(nz(topPullbackLow, low), low)

if doubleBottomContext
    if bar_index - doubleBottomBar > maxBarsAfterDouble
        doubleBottomContext := false
        bottomPullbackState := 0
    else if bottomPullbackState == 0 and high > high[1]
        bottomPullbackState := 1
        bottomPullbackHigh := high
    else if bottomPullbackState == 1
        bottomPullbackHigh := math.max(nz(bottomPullbackHigh, high), high)

shortPullbackDepth = not na(doubleTopHigh) and not na(topPullbackLow) ? doubleTopHigh - topPullbackLow : na
longPullbackDepth = not na(doubleBottomLow) and not na(bottomPullbackHigh) ? bottomPullbackHigh - doubleBottomLow : na

shortDpSignal = doubleTopContext and topPullbackState == 1 and not na(shortPullbackDepth) and shortPullbackDepth >= atr * pullbackMinAtr and shortPullbackDepth <= atr * pullbackMaxAtr and strongBearSignal
longDpSignal = doubleBottomContext and bottomPullbackState == 1 and not na(longPullbackDepth) and longPullbackDepth >= atr * pullbackMinAtr and longPullbackDepth <= atr * pullbackMaxAtr and strongBullSignal

triggerShortDp = shortDpSignal[1] and low < low[1]
triggerLongDp = longDpSignal[1] and high > high[1]

if triggerShortDp
    doubleTopContext := false
    topPullbackState := 0

if triggerLongDp
    doubleBottomContext := false
    bottomPullbackState := 0

plotshape(triggerLongDp, title="DB Pullback Long", style=shape.triangleup, location=location.belowbar, color=color.teal, size=size.small, text="DP")
plotshape(triggerShortDp, title="DT Pullback Short", style=shape.triangledown, location=location.abovebar, color=color.purple, size=size.small, text="DP")

alertcondition(triggerLongDp, "DB Pullback Long", "Double-bottom pullback long candidate triggered")
alertcondition(triggerShortDp, "DT Pullback Short", "Double-top pullback short candidate triggered")
