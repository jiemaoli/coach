//@version=5
indicator("A2 Setup PRO - Author Definition", overlay=true, max_labels_count=500)

// 1. Inputs
emaLen = input.int(20, "EMA period")
atrLen = input.int(14, "ATR period")
trendLookback = input.int(5, "Trend breakout lookback")
maxPullbackBars = input.int(24, "Max pullback bars")

minBarAtr = input.float(0.25, "Min signal bar size in ATR", step=0.05)
maxBarAtr = input.float(1.80, "Max signal bar size in ATR", step=0.05)
minBodyPct = input.float(0.40, "Min signal body %", step=0.05)
maxEntryTailPct = input.float(0.30, "Max entry-side tail %", step=0.05)

nearAboveAtr = input.float(0.30, "EMA near band above", step=0.05)
nearBelowAtr = input.float(0.80, "EMA near band beyond", step=0.05)
minPullbackAtr = input.float(0.35, "Min pullback depth in ATR", step=0.05)
contextInvalidAtr = input.float(1.20, "Context invalidation beyond EMA", step=0.10)

bwLen = input.int(5, "Barb wire window")
bwRangeAtr = input.float(1.50, "Barb wire max range ATR", step=0.10)
bwMinDojis = input.int(2, "Barb wire min dojis")

failTrackBars = input.int(10, "Failed A2 tracking bars")
minRiskAtr = input.float(0.20, "Min risk floor in ATR", step=0.05)

showBarCount = input.bool(true, "Show session bar count")
barCountSession = input.session("0000-2359", "Bar count session")
barCountEvery = input.int(5, "Show every Nth bar number", minval=1)
barCountShowFirst = input.bool(true, "Always show b1")
barCountMax = input.int(120, "Max bars to number per session", minval=1)
barCountOffsetAtr = input.float(0.25, "Bar count label offset ATR", step=0.05)

// 2. Base series
ema20 = ta.ema(close, emaLen)
atr = ta.atr(atrLen)
plot(ema20, color=color.blue, linewidth=2, title="20 EMA")

emaSlope = (ema20 - ema20[5]) / 5
priorHigh = ta.highest(high[1], trendLookback)
priorLow = ta.lowest(low[1], trendLookback)

// Session bar count. Use this to replace a separate bar-count indicator on TradingView free plans.
inBarCountSession = not na(time(timeframe.period, barCountSession))
newBarCountSession = inBarCountSession and (na(inBarCountSession[1]) or not inBarCountSession[1])
var int sessionBarCount = 0

if newBarCountSession
    sessionBarCount := 1
else if inBarCountSession
    sessionBarCount += 1
else
    sessionBarCount := 0

showThisBarNumber = showBarCount and inBarCountSession and sessionBarCount <= barCountMax and ((barCountShowFirst and sessionBarCount == 1) or sessionBarCount % barCountEvery == 0)

if showThisBarNumber
    label.new(bar_index, high + atr * barCountOffsetAtr, "b" + str.tostring(sessionBarCount), style=label.style_none, textcolor=color.new(color.gray, 20), size=size.tiny)

// 3. Bar quality
barRangeRaw = high - low
barRange = math.max(barRangeRaw, syminfo.mintick)
body = math.abs(close - open)
upperTail = high - math.max(open, close)
lowerTail = math.min(open, close) - low

isBullBar = close > open
isBearBar = close < open
isDoji = body <= barRange * 0.25

validSize = barRangeRaw >= atr * minBarAtr and barRangeRaw <= atr * maxBarAtr
strongBullSignal = isBullBar and body >= barRange * minBodyPct and upperTail <= barRange * maxEntryTailPct
strongBearSignal = isBearBar and body >= barRange * minBodyPct and lowerTail <= barRange * maxEntryTailPct

// 4. Barb wire
dojiCount = math.sum(isDoji ? 1.0 : 0.0, bwLen)
recentRange = ta.highest(high, bwLen) - ta.lowest(low, bwLen)
isBarbWire = recentRange <= atr * bwRangeAtr and dojiCount >= bwMinDojis

// 5. Latched trend context
var bool bullContext = false
var bool bearContext = false

var int bullState = 0
var float bullSwingHigh = na
var float bullPullbackLow = na
var float bullH1Low = na
var int bullPullbackStart = na

var int bearState = 0
var float bearSwingLow = na
var float bearPullbackHigh = na
var float bearL1High = na
var int bearPullbackStart = na

strongBullBreakout = close > ema20 and emaSlope > 0 and high > priorHigh
strongBearBreakout = close < ema20 and emaSlope < 0 and low < priorLow

if strongBullBreakout
    bullContext := true
    bearContext := false
    bullSwingHigh := high
    bullState := 0
    bearState := 0
    bullPullbackStart := na

if strongBearBreakout
    bearContext := true
    bullContext := false
    bearSwingLow := low
    bearState := 0
    bullState := 0
    bearPullbackStart := na

if bullContext and (strongBearBreakout or close < ema20 - atr * contextInvalidAtr)
    bullContext := false
    bullState := 0
    bullPullbackStart := na

if bearContext and (strongBullBreakout or close > ema20 + atr * contextInvalidAtr)
    bearContext := false
    bearState := 0
    bearPullbackStart := na

// 6. Bull A2 state machine: trend push -> leg 1 down -> H1 -> H1 fails -> leg 2 -> H2 signal
if bullContext
    int nextBullState = bullState

    if not na(bullSwingHigh) and high > bullSwingHigh
        bullSwingHigh := high
        nextBullState := 0
        bullPullbackLow := na
        bullH1Low := na
        bullPullbackStart := na
    else if bullState == 0 and low < low[1]
        nextBullState := 1
        bullPullbackLow := low
        bullPullbackStart := bar_index
    else if bullState == 1
        bullPullbackLow := math.min(nz(bullPullbackLow, low), low)
        if high > high[1]
            nextBullState := 2
            bullH1Low := low
    else if bullState == 2
        bullPullbackLow := math.min(nz(bullPullbackLow, low), low)
        if low < nz(bullH1Low, low[1]) or low < low[1]
            nextBullState := 3
    else if bullState == 3
        bullPullbackLow := math.min(nz(bullPullbackLow, low), low)

    if not na(bullPullbackStart) and bar_index - bullPullbackStart > maxPullbackBars
        nextBullState := 0
        bullPullbackLow := na
        bullH1Low := na
        bullPullbackStart := na

    bullState := nextBullState
else
    bullState := 0

// 7. Bear A2 / M2S state machine: trend push -> leg 1 up -> L1 -> L1 fails -> leg 2 -> L2 signal
if bearContext
    int nextBearState = bearState

    if not na(bearSwingLow) and low < bearSwingLow
        bearSwingLow := low
        nextBearState := 0
        bearPullbackHigh := na
        bearL1High := na
        bearPullbackStart := na
    else if bearState == 0 and high > high[1]
        nextBearState := 1
        bearPullbackHigh := high
        bearPullbackStart := bar_index
    else if bearState == 1
        bearPullbackHigh := math.max(nz(bearPullbackHigh, high), high)
        if low < low[1]
            nextBearState := 2
            bearL1High := high
    else if bearState == 2
        bearPullbackHigh := math.max(nz(bearPullbackHigh, high), high)
        if high > nz(bearL1High, high[1]) or high > high[1]
            nextBearState := 3
    else if bearState == 3
        bearPullbackHigh := math.max(nz(bearPullbackHigh, high), high)

    if not na(bearPullbackStart) and bar_index - bearPullbackStart > maxPullbackBars
        nextBearState := 0
        bearPullbackHigh := na
        bearL1High := na
        bearPullbackStart := na

    bearState := nextBearState
else
    bearState := 0

// 8. A2 signal bar qualification
longNearEma = low <= ema20 + atr * nearAboveAtr and low >= ema20 - atr * nearBelowAtr
shortNearEma = high >= ema20 - atr * nearAboveAtr and high <= ema20 + atr * nearBelowAtr

longTouchedEma = not na(bullPullbackLow) and bullPullbackLow <= ema20 + atr * nearAboveAtr and bullPullbackLow >= ema20 - atr * nearBelowAtr
shortTouchedEma = not na(bearPullbackHigh) and bearPullbackHigh >= ema20 - atr * nearAboveAtr and bearPullbackHigh <= ema20 + atr * nearBelowAtr

longDeepEnough = not na(bullSwingHigh) and not na(bullPullbackLow) and bullSwingHigh - bullPullbackLow >= atr * minPullbackAtr
shortDeepEnough = not na(bearSwingLow) and not na(bearPullbackHigh) and bearPullbackHigh - bearSwingLow >= atr * minPullbackAtr

longSignal = bullContext and bullState == 3 and longNearEma and longTouchedEma and longDeepEnough and validSize and strongBullSignal
shortSignal = bearContext and bearState == 3 and shortNearEma and shortTouchedEma and shortDeepEnough and validSize and strongBearSignal

longSignalTarget = longSignal ? bullSwingHigh : na
shortSignalTarget = shortSignal ? bearSwingLow : na

// 9. Stop-entry trigger on the bar after the signal bar
triggerLong = longSignal[1] and high > high[1]
triggerShort = shortSignal[1] and low < low[1]

validA2Long = triggerLong and not isBarbWire[1]
warnA2Long = triggerLong and isBarbWire[1]

validA2Short = triggerShort and not isBarbWire[1]
warnA2Short = triggerShort and isBarbWire[1]

if triggerLong
    bullState := 0
    bullPullbackStart := na

if triggerShort
    bearState := 0
    bearPullbackStart := na

plotshape(validA2Long, title="A2 Long", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="A2")
plotshape(warnA2Long, title="BW A2 Long", style=shape.triangleup, location=location.belowbar, color=color.gray, size=size.small, text="bwA2")
plotshape(validA2Short, title="A2 Short / M2S", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="M2S")
plotshape(warnA2Short, title="BW A2 Short", style=shape.triangledown, location=location.abovebar, color=color.gray, size=size.small, text="bwM2S")

// 10. Failed A2 tracking
var bool inLongA2 = false
var bool inShortA2 = false
var float longEntry = na
var float longStop = na
var float longTarget = na
var int longEntryBar = na
var float shortEntry = na
var float shortStop = na
var float shortTarget = na
var int shortEntryBar = na

if triggerLong
    inLongA2 := true
    inShortA2 := false
    longEntry := high[1]
    longStop := low[1]
    longRisk = math.max(longEntry - longStop, atr[1] * minRiskAtr)
    baseTarget = longSignalTarget[1]
    longTarget := not na(baseTarget) and baseTarget > longEntry + longRisk ? baseTarget : longEntry + 2.0 * longRisk
    longEntryBar := bar_index

if triggerShort
    inShortA2 := true
    inLongA2 := false
    shortEntry := low[1]
    shortStop := high[1]
    shortRisk = math.max(shortStop - shortEntry, atr[1] * minRiskAtr)
    baseTarget = shortSignalTarget[1]
    shortTarget := not na(baseTarget) and baseTarget < shortEntry - shortRisk ? baseTarget : shortEntry - 2.0 * shortRisk
    shortEntryBar := bar_index

failedLongA2 = inLongA2 and bar_index > longEntryBar and low < longStop
failedShortA2 = inShortA2 and bar_index > shortEntryBar and high > shortStop

if inLongA2 and (bar_index - longEntryBar > failTrackBars or high >= longTarget)
    inLongA2 := false

if inShortA2 and (bar_index - shortEntryBar > failTrackBars or low <= shortTarget)
    inShortA2 := false

if failedLongA2
    inLongA2 := false

if failedShortA2
    inShortA2 := false

plotshape(failedLongA2, title="Failed A2 Long", style=shape.xcross, location=location.belowbar, color=color.fuchsia, size=size.small, text="fA2")
plotshape(failedShortA2, title="Failed A2 Short", style=shape.xcross, location=location.abovebar, color=color.fuchsia, size=size.small, text="fA2")

alertcondition(validA2Long, "A2 Long", "A2 long triggered")
alertcondition(validA2Short, "A2 Short / M2S", "A2 short triggered")
alertcondition(warnA2Long, "BW A2 Long", "A2 long triggered in barb wire")
alertcondition(warnA2Short, "BW A2 Short", "A2 short triggered in barb wire")
alertcondition(failedLongA2, "Failed A2 Long", "Long A2 failed")
alertcondition(failedShortA2, "Failed A2 Short", "Short A2 failed")
