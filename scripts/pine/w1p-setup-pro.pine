//@version=5
indicator("W1P Setup PRO - Wedge First Pullback Helper", overlay=true, max_labels_count=500)

// 1. Inputs
emaLen = input.int(20, "EMA period")
atrLen = input.int(14, "ATR period")
leftRight = input.int(2, "Pivot strength")
wedgeMaxBars = input.int(60, "Max bars from first to third push")
reversalTrackBars = input.int(16, "Bars to wait for first pullback")

minWedgeMoveAtr = input.float(1.20, "Min wedge move in ATR", step=0.10)
minThirdPushOvershootAtr = input.float(0.10, "Min third-push overshoot ATR", step=0.05)
pullbackMinAtr = input.float(0.25, "Min first pullback depth ATR", step=0.05)
pullbackMaxAtr = input.float(1.80, "Max first pullback depth ATR", step=0.10)

minBodyPct = input.float(0.35, "Min signal body %", step=0.05)
maxEntryTailPct = input.float(0.35, "Max entry-side tail %", step=0.05)
maxSignalAtr = input.float(1.80, "Max signal bar size ATR", step=0.10)

bwLen = input.int(5, "Barb wire window")
bwRangeAtr = input.float(1.50, "Barb wire max range ATR", step=0.10)
bwMinDojis = input.int(2, "Barb wire min dojis")

showBarCount = input.bool(true, "Show session bar count")
barCountSession = input.session("0000-2359", "Bar count session")
barCountEvery = input.int(5, "Show every Nth bar number", minval=1)
barCountShowFirst = input.bool(true, "Always show b1")
barCountMax = input.int(120, "Max bars to number per session", minval=1)
barCountOffsetAtr = input.float(0.25, "Bar count label offset ATR", step=0.05)

// 2. Base series
ema20 = ta.ema(close, emaLen)
atr = ta.atr(atrLen)
plot(ema20, color=color.blue, linewidth=2, title="20 EMA")

// Session bar count. Use this to replace a separate bar-count indicator on TradingView free plans.
inBarCountSession = not na(time(timeframe.period, barCountSession))
newBarCountSession = inBarCountSession and (na(inBarCountSession[1]) or not inBarCountSession[1])
var int sessionBarCount = 0

if newBarCountSession
    sessionBarCount := 1
else if inBarCountSession
    sessionBarCount += 1
else
    sessionBarCount := 0

showThisBarNumber = showBarCount and inBarCountSession and sessionBarCount <= barCountMax and ((barCountShowFirst and sessionBarCount == 1) or sessionBarCount % barCountEvery == 0)

if showThisBarNumber
    label.new(bar_index, high + atr * barCountOffsetAtr, "b" + str.tostring(sessionBarCount), style=label.style_none, textcolor=color.new(color.gray, 20), size=size.tiny)

barRangeRaw = high - low
barRange = math.max(barRangeRaw, syminfo.mintick)
body = math.abs(close - open)
upperTail = high - math.max(open, close)
lowerTail = math.min(open, close) - low

isBullBar = close > open
isBearBar = close < open
isDoji = body <= barRange * 0.25

strongBullSignal = isBullBar and body >= barRange * minBodyPct and upperTail <= barRange * maxEntryTailPct and barRangeRaw <= atr * maxSignalAtr
strongBearSignal = isBearBar and body >= barRange * minBodyPct and lowerTail <= barRange * maxEntryTailPct and barRangeRaw <= atr * maxSignalAtr

dojiCount = math.sum(isDoji ? 1.0 : 0.0, bwLen)
recentRange = ta.highest(high, bwLen) - ta.lowest(low, bwLen)
isBarbWire = recentRange <= atr * bwRangeAtr and dojiCount >= bwMinDojis

// 3. Pivot tracking for three-push wedge candidates
ph = ta.pivothigh(high, leftRight, leftRight)
pl = ta.pivotlow(low, leftRight, leftRight)
phBar = bar_index - leftRight
plBar = bar_index - leftRight

var float hi1 = na
var float hi2 = na
var float hi3 = na
var int hi1Bar = na
var int hi2Bar = na
var int hi3Bar = na

var float lo1 = na
var float lo2 = na
var float lo3 = na
var int lo1Bar = na
var int lo2Bar = na
var int lo3Bar = na

if not na(ph)
    hi1 := hi2
    hi1Bar := hi2Bar
    hi2 := hi3
    hi2Bar := hi3Bar
    hi3 := ph
    hi3Bar := phBar

if not na(pl)
    lo1 := lo2
    lo1Bar := lo2Bar
    lo2 := lo3
    lo2Bar := lo3Bar
    lo3 := pl
    lo3Bar := plBar

bearWedgeCandidate = not na(hi1) and not na(hi2) and not na(hi3) and hi1Bar < hi2Bar and hi2Bar < hi3Bar and hi3Bar - hi1Bar <= wedgeMaxBars and hi2 > hi1 and hi3 > hi2 and hi3 - hi1 >= atr * minWedgeMoveAtr and hi3 - hi2 >= atr * minThirdPushOvershootAtr
bullWedgeCandidate = not na(lo1) and not na(lo2) and not na(lo3) and lo1Bar < lo2Bar and lo2Bar < lo3Bar and lo3Bar - lo1Bar <= wedgeMaxBars and lo2 < lo1 and lo3 < lo2 and lo1 - lo3 >= atr * minWedgeMoveAtr and lo2 - lo3 >= atr * minThirdPushOvershootAtr

// 4. Reversal context after wedge
var bool bullReversalContext = false
var bool bearReversalContext = false
var float bullReversalHigh = na
var float bullPullbackLow = na
var int bullReversalBar = na
var int bullPullbackState = 0

var float bearReversalLow = na
var float bearPullbackHigh = na
var int bearReversalBar = na
var int bearPullbackState = 0

// Bull W1P: three pushes down, then a bull reversal, then first pullback and continuation trigger.
if bullWedgeCandidate and strongBullSignal
    bullReversalContext := true
    bearReversalContext := false
    bullReversalHigh := high
    bullPullbackLow := na
    bullReversalBar := bar_index
    bullPullbackState := 0

// Bear W1P: three pushes up, then a bear reversal, then first pullback and continuation trigger.
if bearWedgeCandidate and strongBearSignal
    bearReversalContext := true
    bullReversalContext := false
    bearReversalLow := low
    bearPullbackHigh := na
    bearReversalBar := bar_index
    bearPullbackState := 0

if bullReversalContext
    if high > nz(bullReversalHigh, high)
        bullReversalHigh := high
    if bar_index - bullReversalBar > reversalTrackBars
        bullReversalContext := false
        bullPullbackState := 0
    else if bullPullbackState == 0 and low < low[1]
        bullPullbackState := 1
        bullPullbackLow := low
    else if bullPullbackState == 1
        bullPullbackLow := math.min(nz(bullPullbackLow, low), low)

if bearReversalContext
    if low < nz(bearReversalLow, low)
        bearReversalLow := low
    if bar_index - bearReversalBar > reversalTrackBars
        bearReversalContext := false
        bearPullbackState := 0
    else if bearPullbackState == 0 and high > high[1]
        bearPullbackState := 1
        bearPullbackHigh := high
    else if bearPullbackState == 1
        bearPullbackHigh := math.max(nz(bearPullbackHigh, high), high)

longPullbackDepth = not na(bullReversalHigh) and not na(bullPullbackLow) ? bullReversalHigh - bullPullbackLow : na
shortPullbackDepth = not na(bearReversalLow) and not na(bearPullbackHigh) ? bearPullbackHigh - bearReversalLow : na

longW1pSignal = bullReversalContext and bullPullbackState == 1 and not na(longPullbackDepth) and longPullbackDepth >= atr * pullbackMinAtr and longPullbackDepth <= atr * pullbackMaxAtr and strongBullSignal
shortW1pSignal = bearReversalContext and bearPullbackState == 1 and not na(shortPullbackDepth) and shortPullbackDepth >= atr * pullbackMinAtr and shortPullbackDepth <= atr * pullbackMaxAtr and strongBearSignal

triggerLongW1p = longW1pSignal[1] and high > high[1]
triggerShortW1p = shortW1pSignal[1] and low < low[1]

validLongW1p = triggerLongW1p and not isBarbWire[1]
warnLongW1p = triggerLongW1p and isBarbWire[1]
validShortW1p = triggerShortW1p and not isBarbWire[1]
warnShortW1p = triggerShortW1p and isBarbWire[1]

if triggerLongW1p
    bullReversalContext := false
    bullPullbackState := 0

if triggerShortW1p
    bearReversalContext := false
    bearPullbackState := 0

plotshape(validLongW1p, title="W1P Long", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="W1P")
plotshape(warnLongW1p, title="BW W1P Long", style=shape.triangleup, location=location.belowbar, color=color.gray, size=size.small, text="bwW1P")
plotshape(validShortW1p, title="W1P Short", style=shape.triangledown, location=location.abovebar, color=color.orange, size=size.small, text="W1P")
plotshape(warnShortW1p, title="BW W1P Short", style=shape.triangledown, location=location.abovebar, color=color.gray, size=size.small, text="bwW1P")

alertcondition(validLongW1p, "W1P Long", "W1P long candidate triggered")
alertcondition(validShortW1p, "W1P Short", "W1P short candidate triggered")
alertcondition(warnLongW1p, "BW W1P Long", "W1P long candidate triggered in barb wire")
alertcondition(warnShortW1p, "BW W1P Short", "W1P short candidate triggered in barb wire")
